# Local development only. Replace this with `openssl rand -base64 32` outside local development.
BETTER_AUTH_SECRET=local-development-only-replace-this-with-a-random-secret
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated additional origins; development also permits the Arena preview origin.
BETTER_AUTH_TRUSTED_ORIGINS=

# SMTP email verification and password recovery delivery. Replace every placeholder before enabling real signups.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-this-smtp-user
SMTP_PASSWORD=replace-this-smtp-password-with-a-long-random-value
EMAIL_FROM=noreply@example.com
# Optional PEM CA bundle path for a private SMTP service.
SMTP_TLS_CA=

# Local PostgreSQL from compose.yaml. Never reuse these credentials in production.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/commitmentos

# Local background job queue. Provision Redis with authentication/TLS in shared environments.
REDIS_URL=redis://localhost:6379
JOBS_QUEUE_NAME=commitmentos
JOBS_QUEUE_PREFIX=commitmentos
JOB_WORKER_CONCURRENCY=5
JOB_MAX_ATTEMPTS=5
JOB_BACKOFF_MS=1000
JOB_TIMEOUT_MS=60000
JOB_HEARTBEAT_INTERVAL_MS=10000
JOB_HEARTBEAT_STALE_MS=30000
JOB_RECOVERY_INTERVAL_MS=5000
# Optional internal Prometheus endpoint; use `openssl rand -hex 32` and restrict network access.
JOBS_METRICS_TOKEN=

# Workspace Gmail OAuth remains disabled until scope, consent, mailbox, and retention policy are approved.
GMAIL_OAUTH_ENABLED=false
# Set these only after approving the exact read-only/identity scopes documented in docs/gmail-integration.md.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# AES-256-GCM key for OAuth credentials and short-lived PKCE state; generate with `openssl rand -base64 32`.
INTEGRATION_ENCRYPTION_KEY=
