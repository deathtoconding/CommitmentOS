# Local development only. Replace this with `openssl rand -base64 32` outside local development.
BETTER_AUTH_SECRET=local-development-only-replace-this-with-a-random-secret
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated additional origins; development also permits the Arena preview origin.
BETTER_AUTH_TRUSTED_ORIGINS=

# Local PostgreSQL from compose.yaml. Never reuse these credentials in production.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/commitmentos
